# Создать образ на основе базового слоя,
# который содержит файлы ОС и интерпретатор Python
FROM python:3.13-slim

# Переходим в образе в директорию /app: в ней будем хранить код проекта.
# Если директории с указанным именем нет, она будет создана. 
# Название директории может быть любым.
WORKDIR /app
# Дальнейшие инструкции будут выполняться в директории /app

# Устанавливаем uv для быстрого и надежного менеджмента зависимостей
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Копируем манифесты зависимостей для эффективного кэширования слоев
COPY pyproject.toml uv.lock ./

# Устанавливаем зависимости без создания лишних виртуальных окружений (прямо в системный Python контейнера)
RUN uv sync --frozen --no-dev --no-install-project

# Создаем необходимые папки
RUN mkdir -p temp logs

# Копируем остальной код проекта
COPY . .

# Делаем entrypoint.sh исполняемым внутри образа
RUN chmod +x /app/entrypoint.sh

# Настраиваем entrypoint и команду по умолчанию
ENTRYPOINT ["/app/entrypoint.sh"]

# Запуск через uv run или python
CMD ["uv", "run", "python", "main.py"]